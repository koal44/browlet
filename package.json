{
  "name": "nwsapi",
  "version": "2.2.23-fork.0",
  "description": "Fast CSS Selectors API Engine",
  "homepage": "https://github.com/koal44/nwsapi-lab",
  "main": "./dist/nwsapi.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "css",
    "css3",
    "css4",
    "matcher",
    "selector"
  ],
  "license": "MIT",
  "author": {
    "name": "Diego Perini"
  },
  "maintainers": [
    {
      "name": "Eric Knowlton"
    }
  ],
  "bugs": {
    "url": "https://github.com/koal44/nwsapi-lab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koal44/nwsapi-lab.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src test scripts",
    "test:browser": "npm run build && cross-env HARNESS_MODE=normal playwright test --project=browser",
    "test:browser:fixme": "npm run build && cross-env HARNESS_MODE=fixme playwright test --project=browser",
    "test:perf": "npm run build && playwright test --project=perf --workers=1",
    "test:unit": "npm run build && vitest run",
    "test:artifact": "npm run build && node test/artifact/cjs.test.cjs && node test/artifact/global.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "cross-env": "^10.1.0",
    "eslint": "9.31.0",
    "playwright": "^1.59.1",
    "rollup": "^4.60.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
