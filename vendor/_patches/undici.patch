diff --git a/test/http2-raw-headers.js b/test/http2-raw-headers.js
new file mode 100644
index 0000000..8764441
--- /dev/null
+++ b/test/http2-raw-headers.js
@@ -0,0 +1,162 @@
+'use strict'
+
+const assert = require('node:assert/strict')
+const { test } = require('node:test')
+const { once } = require('node:events')
+const { readFileSync } = require('node:fs')
+const { join } = require('node:path')
+const { createSecureServer } = require('node:http2')
+const { Client, Dispatcher1Wrapper } = require('..')
+
+const tls = {
+  key: readFileSync(join(__dirname, 'fixtures/key.pem')),
+  cert: readFileSync(join(__dirname, 'fixtures/cert.pem'))
+}
+
+for (const allowH2 of [false, true]) {
+  test(`raw dispatch headers preserve field boundaries (allowH2: ${allowH2})`, async t => {
+    const { client } = await setup(t, allowH2)
+    const responses = []
+    const result = await new Promise((resolve, reject) => {
+      client.dispatch({ path: '/', method: 'GET' }, {
+        onRequestStart () {},
+        onResponseStart (controller, statusCode, headers) {
+          responses.push({ statusCode, headers, raw: controller.rawHeaders })
+        },
+        onResponseData () {},
+        onResponseEnd (controller, trailers) {
+          resolve({ trailers, raw: controller.rawTrailers })
+        },
+        onResponseError (_controller, error) { reject(error) }
+      })
+    })
+
+    assert.deepEqual(responses.map(response => response.statusCode), [103, 200])
+    assert.deepEqual(values(responses[0].raw, 'x-info'), ['first', 'second'])
+    assert.deepEqual(values(responses[1].raw, 'strict-transport-security'), ['max-age=10', 'max-age=20'])
+    assert.deepEqual(values(responses[1].raw, 'x-literal-comma'), ['a, b'])
+    assert.deepEqual(values(responses[1].raw, 'set-cookie'), ['a=1', 'b=2'])
+    assert.deepEqual(values(result.raw, 'x-trailer'), ['first', 'second'])
+    assert.deepEqual(responses[1].headers['strict-transport-security'], allowH2 ? 'max-age=10, max-age=20' : ['max-age=10', 'max-age=20'])
+    assert.deepEqual(result.trailers['x-trailer'], allowH2 ? 'first, second' : ['first', 'second'])
+    assert.ok(responses.every(response => !response.raw.some((value, index) => index % 2 === 0 && value.toString()[0] === ':')))
+  })
+
+  test(`request raw headers preserve field boundaries (allowH2: ${allowH2})`, async t => {
+    const { client } = await setup(t, allowH2)
+    const response = await client.request({ path: '/', method: 'GET', responseHeaders: 'raw' })
+    await response.body.dump()
+
+    assert.deepEqual(values(response.headers, 'strict-transport-security'), ['max-age=10', 'max-age=20'])
+    assert.deepEqual(values(response.headers, 'x-literal-comma'), ['a, b'])
+  })
+
+  test(`legacy raw headers preserve field boundaries (allowH2: ${allowH2})`, async t => {
+    const { client } = await setup(t, allowH2)
+    const responses = []
+    const trailers = await new Promise((resolve, reject) => {
+      client.dispatch({ path: '/', method: 'GET' }, Dispatcher1Wrapper.wrapHandler({
+        onConnect () {},
+        onHeaders (statusCode, headers) {
+          responses.push({ statusCode, headers })
+          return true
+        },
+        onData () { return true },
+        onComplete: resolve,
+        onError: reject
+      }))
+    })
+
+    assert.deepEqual(responses.map(response => response.statusCode), [103, 200])
+    assert.deepEqual(values(responses[0].headers, 'x-info'), ['first', 'second'])
+    assert.deepEqual(values(responses[1].headers, 'strict-transport-security'), ['max-age=10', 'max-age=20'])
+    assert.deepEqual(values(responses[1].headers, 'x-test-header'), ['caf\u00e9'])
+    assert.deepEqual(values(trailers, 'x-trailer'), ['first', 'second'])
+    assert.ok(responses.every(response => response.headers.every(Buffer.isBuffer)))
+    assert.ok(trailers.every(Buffer.isBuffer))
+  })
+}
+
+for (const legacy of [false, true]) {
+  test(`HTTP/2 CONNECT raw headers preserve field boundaries (legacy: ${legacy})`, async t => {
+    const server = createSecureServer(tls)
+    server.on('stream', stream => {
+      stream.respond({ ':status': 200, 'x-tunnel': ['first', 'second'] })
+      stream.end()
+    })
+    const client = await createClient(t, server, true)
+    const headers = await new Promise((resolve, reject) => {
+      const complete = (statusCode, headers, socket) => {
+        assert.equal(statusCode, 200)
+        socket.on('error', reject)
+        socket.on('end', () => resolve(headers))
+        socket.resume()
+        socket.end()
+      }
+      const handler = legacy
+        ? Dispatcher1Wrapper.wrapHandler({
+          onConnect () {},
+          onUpgrade: complete,
+          onError: reject
+        })
+        : {
+            onRequestStart () {},
+            onRequestUpgrade (controller, statusCode, _headers, socket) {
+              complete(statusCode, controller.rawHeaders, socket)
+            },
+            onResponseError (_controller, error) { reject(error) }
+          }
+      client.dispatch({ path: '/', method: 'CONNECT' }, handler)
+    })
+
+    assert.deepEqual(values(headers, 'x-tunnel'), ['first', 'second'])
+    assert.ok(headers.every(Buffer.isBuffer))
+    assert.ok(!headers.some((value, index) => index % 2 === 0 && value.toString()[0] === ':'))
+  })
+}
+
+async function setup (t, allowH2) {
+  const server = createSecureServer({ ...tls, allowHTTP1: true })
+  server.on('request', (request, response) => {
+    assert.equal(request.httpVersion, allowH2 ? '2.0' : '1.1')
+    if (allowH2) {
+      response.stream.additionalHeaders({ ':status': 103, 'x-info': ['first', 'second'] })
+    } else {
+      // writeEarlyHints() stringifies arrays before sending them over HTTP/1.
+      response.socket.write('HTTP/1.1 103 Early Hints\r\nx-info: first\r\nx-info: second\r\n\r\n')
+    }
+    response.writeHead(200, {
+      'strict-transport-security': ['max-age=10', 'max-age=20'],
+      'x-literal-comma': 'a, b',
+      'x-test-header': 'caf\u00e9',
+      'set-cookie': ['a=1', 'b=2']
+    })
+    response.write('ok')
+    response.addTrailers({ 'x-trailer': ['first', 'second'] })
+    response.end()
+  })
+  const client = await createClient(t, server, allowH2)
+  return { client }
+}
+
+async function createClient (t, server, allowH2) {
+  await once(server.listen(0, '127.0.0.1'), 'listening')
+  const client = new Client(`https://127.0.0.1:${server.address().port}`, {
+    allowH2,
+    connect: { rejectUnauthorized: false }
+  })
+  t.after(async () => {
+    await client.destroy()
+    await new Promise(resolve => server.close(resolve))
+  })
+  return client
+}
+
+function values (headers, name) {
+  assert.ok(Array.isArray(headers), 'Raw headers must be an array of original field pairs')
+  const result = []
+  for (let index = 0; index < headers.length; index += 2) {
+    if (headers[index].toString('latin1') === name) result.push(headers[index + 1].toString('latin1'))
+  }
+  return result
+}
