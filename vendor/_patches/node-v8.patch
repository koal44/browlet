+    auto next = CompileRun(R"JS(
+      (() => {
+        let count = 0;
+        return () => ({ value: ++count, done: count > 2 });
+      })()
+    )JS")
+                    .As<v8::Function>();
+    auto iterator =
+        v8::CollectionIterator::New(env.local(), kind, next).ToLocalChecked();
+    CHECK(env->Global()
+              ->Set(env.local(), v8_str("iterator"), iterator)
+              .FromJust());
+    CHECK(env->Global()
+              ->Set(env.local(), v8_str("nativeNext"),
+                    CompileRun(
+                        is_map
+                            ? "Object.getPrototypeOf(new Map().values()).next"
+                            : "Object.getPrototypeOf(new Set().values()).next"))
+              .FromJust());
+    CHECK(CompileRun(R"JS(
+      (() => {
+        if (iterator.next !== nativeNext) return false;
+        if (iterator[Symbol.iterator]() !== iterator) return false;
+        if (nativeNext.call(iterator).value !== 1) return false;
+        Object.setPrototypeOf(iterator, null);
+        if (nativeNext.call(iterator).value !== 2) return false;
+        const result = nativeNext.call(iterator);
+        if (!result.done || result.value !== undefined) return false;
+        return nativeNext.call(iterator).done;
+      })()
+    )JS")
+              ->IsTrue());
+
+    next = CompileRun("() => nativeNext.call(iterator)").As<v8::Function>();
+    iterator =
+        v8::CollectionIterator::New(env.local(), kind, next).ToLocalChecked();
+    CHECK(env->Global()
+              ->Set(env.local(), v8_str("iterator"), iterator)
+              .FromJust());
+    CHECK(CompileRun(R"JS(
+      (() => {
+        let threw = false;
+        try { nativeNext.call(iterator); }
+        catch (error) { threw = error instanceof TypeError; }
+        return threw && nativeNext.call(iterator).done;
+      })()
+    )JS")
+              ->IsTrue());
+
+    next = CompileRun("() => ({ get done() { throw undefined; } })")
+               .As<v8::Function>();
+    iterator =
+        v8::CollectionIterator::New(env.local(), kind, next).ToLocalChecked();
+    CHECK(env->Global()
+              ->Set(env.local(), v8_str("iterator"), iterator)
+              .FromJust());
+    CHECK(CompileRun(R"JS(
+      (() => {
+        let threw = false;
+        try { nativeNext.call(iterator); }
+        catch (error) { threw = error === undefined; }
+        return threw && nativeNext.call(iterator).done;
+      })()
+    )JS")
+              ->IsTrue());
+  }
+}
