+
+void Isolate::EnqueuePromiseJob(DirectHandle<Microtask> task) {
+  auto info = GetPromiseJobInfo(this, task);
+  auto* queue = info.context->microtask_queue();
+  if (queue == nullptr) return;
+  if (promise_job_enqueue_hook_ == nullptr) {
+    queue->EnqueueMicrotask(*task);
+    return;
+  }
+  auto context = factory()->NewBuiltinContext(info.context,
+                                              Context::MIN_CONTEXT_SLOTS + 1);
+  context->SetNoCell(Context::MIN_CONTEXT_SLOTS, *task);
+  auto shared = factory()->NewSharedFunctionInfoForBuiltin(
+      factory()->empty_string(), Builtin::kRunPromiseJob, 0, kDontAdapt);
+  shared->set_language_mode(LanguageMode::kStrict);
+  auto job =
+      v8::internal::Factory::JSFunctionBuilder{this, shared, context}
+          .set_map(direct_handle(
+              info.context->strict_function_without_prototype_map(), this))
+          .Build();
+  DirectHandle<Object> ambient(
+      isolate_data()->continuation_preserved_embedder_data(), this);
+  ExternalCallbackScope scope(this, FUNCTION_ADDR(promise_job_enqueue_hook_));
+  promise_job_enqueue_hook_(info.realm, queue, info.kind,
+                            v8::Utils::ToLocal(job));
+  isolate_data()->set_continuation_preserved_embedder_data(*ambient);
+  CHECK(!has_exception());
+}
