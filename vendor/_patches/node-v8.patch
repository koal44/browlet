+/** Creates callback-driven iterators with a native collection iterator brand.
+ */
+class V8_EXPORT CollectionIterator {
+ public:
+  enum class Kind { kMap, kSet };
+
+  /**
+   * Creates an iterator with the context's intrinsic Map or Set iterator
+   * prototype. The matching native iterator next method accepts this object,
+   * including when that method is borrowed from another context.
+   *
+   * Each next call invokes the callback with undefined as receiver and no
+   * arguments. The callback must return an IteratorResult object. While done
+   * is false, that object is returned unchanged; the embedder is responsible
+   * for its realm and any per-step value conversion. A truthy done completes
+   * the iterator and returns { value: undefined, done: true }.
+   *
+   * An exception from the callback or reading done, or a non-object result,
+   * permanently completes the iterator. Reentrant next calls throw TypeError.
+   * Completed iterators release the callback and never invoke it again.
+   * Creation does not invoke the callback.
+   */
+  static MaybeLocal<Object> New(Local<Context> context, Kind kind,
+                                Local<Function> next);
+};
 
