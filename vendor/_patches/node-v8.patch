+// Callback-driven collection iterators created through the embedder API.
+transitioning builtin CallbackIteratorNext(
+    implicit context: Context)(iterator: JSCallbackIterator): JSAny {
+  const state = SmiUntag<JSCallbackIteratorState>(iterator.state);
+  if (state == JSCallbackIteratorState::kExecuting) {
+    ThrowTypeError(MessageTemplate::kGeneratorRunning);
+  }
+  if (state == JSCallbackIteratorState::kCompleted) {
+    return AllocateJSIteratorResult(Undefined, True);
+  }
+
+  iterator.state = SmiTag<JSCallbackIteratorState>(
+      JSCallbackIteratorState::kExecuting);
+  try {
+    const next = UnsafeCast<Callable>(iterator.next);
+    const result = Call(context, next, Undefined);
+    const object = Cast<JSReceiver>(result) otherwise ThrowTypeError(
+        MessageTemplate::kIteratorResultNotAnObject, 'CollectionIterator');
+    if (ToBoolean(GetProperty(object, 'done'))) {
+      iterator.next = Undefined;
+      iterator.state = SmiTag<JSCallbackIteratorState>(
+          JSCallbackIteratorState::kCompleted);
+      return AllocateJSIteratorResult(Undefined, True);
+    }
+    iterator.state = SmiTag<JSCallbackIteratorState>(
+        JSCallbackIteratorState::kSuspended);
+    return object;
+  } catch (e, message) {
+    iterator.next = Undefined;
+    iterator.state = SmiTag<JSCallbackIteratorState>(
+        JSCallbackIteratorState::kCompleted);
+    ReThrowWithMessage(context, e, message);
+  }
+}
