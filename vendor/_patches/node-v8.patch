+  }
+  CHECK(
+      env->Global()->Set(env.local(), v8_str("iterator"), iterator).FromJust());
+  CHECK(CompileRun(R"JS(
+    (() => {
+      const result = Object.getPrototypeOf(new Map().values()).next.call(iterator);
+      return result.value === 42 && Object.getPrototypeOf(result) === Object.prototype;
+    })()
+  )JS")
+            ->IsTrue());
+}
