+  ExternalCallbackScope scope(this, FUNCTION_ADDR(generic_job_enqueue_hook_));
+  generic_job_enqueue_hook_(v8::Utils::ToLocal(realm), v8::Utils::ToLocal(job));
+  isolate_data()->set_continuation_preserved_embedder_data(*ambient);
+  CHECK(!has_exception());
+}
