+struct PromiseJobInfo {
+  v8::PromiseJobKind kind;
+  DirectHandle<NativeContext> context;
+  v8::Local<v8::Context> realm;
+};
+
+PromiseJobInfo GetPromiseJobInfo(Isolate* isolate,
+                                 DirectHandle<Microtask> task) {
+  Tagged<Context> context;
+  Tagged<Object> realm;
+  v8::PromiseJobKind kind;
+  if (IsPromiseResolveThenableJobTask(*task)) {
+    auto job = Cast<PromiseResolveThenableJobTask>(task);
+    context = job->context();
+    realm = job->job_realm();
+    kind = v8::PromiseJobKind::kThenable;
+  } else {
+    auto job = Cast<PromiseReactionJobTask>(task);
+    context = job->context();
+    realm = job->job_realm();
+    kind = v8::PromiseJobKind::kReaction;
+  }
+  v8::Local<v8::Context> api_realm;
+  if (!IsUndefined(realm)) {
+    api_realm =
+        v8::Utils::ToLocal(direct_handle(Cast<NativeContext>(realm), isolate));
+  }
+  return {kind, direct_handle(context->native_context(), isolate), api_realm};
+}
