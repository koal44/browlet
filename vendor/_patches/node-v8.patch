+  if (promise_capture_hook_ == nullptr) return ambient;
+  v8::Context::BackupIncumbentScope incumbent_scope(
+      GetIncumbentContextForJobCallback());
+  ExternalCallbackScope scope(this, FUNCTION_ADDR(promise_capture_hook_));
+  auto captured =
+      promise_capture_hook_(kind, v8::Utils::ToLocal(on_fulfilled_or_then),
+                            v8::Utils::ToLocal(on_rejected));
+  isolate_data()->set_continuation_preserved_embedder_data(*ambient);
+  CHECK(!has_exception());
+  CHECK(!captured.IsEmpty());
+  return v8::Utils::OpenDirectHandle(*captured);
+}
