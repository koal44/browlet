+MaybeDirectHandle<Object> Isolate::CallPromiseCallback(
+    v8::PromiseCallbackKind kind, DirectHandle<JSReceiver> callback,
+    DirectHandle<Object> receiver, int argc, v8::Local<v8::Value> argv[]) {
+  DCHECK_NOT_NULL(promise_call_hook_);
+  v8::Local<v8::Value> result;
+  ExternalCallbackScope scope(this, FUNCTION_ADDR(promise_call_hook_));
+  if (!promise_call_hook_(v8::Utils::ToLocal(native_context()), kind,
+                          v8::Utils::ToLocal(callback).As<v8::Function>(),
+                          v8::Utils::ToLocal(receiver), argc, argv)
+           .ToLocal(&result)) {
+    return {};
+  }
+  return v8::Utils::OpenDirectHandle(*result);
