+DirectHandle<Object> Isolate::CaptureFinalizationRegistryContext(
+    DirectHandle<Object> cleanup_callback) {
+  DirectHandle<Object> ambient(
+      isolate_data()->continuation_preserved_embedder_data(), this);
+  DCHECK_NOT_NULL(finalization_registry_capture_hook_);
+  v8::Context::BackupIncumbentScope incumbent_scope(
+      GetIncumbentContextForJobCallback());
+  ExternalCallbackScope scope(
+      this, FUNCTION_ADDR(finalization_registry_capture_hook_));
+  auto captured =
+      finalization_registry_capture_hook_(v8::Utils::ToLocal(cleanup_callback));
+  isolate_data()->set_continuation_preserved_embedder_data(*ambient);
+  CHECK(!has_exception());
+  CHECK(!captured.IsEmpty());
+  return v8::Utils::OpenDirectHandle(*captured);
+}
+
+MaybeDirectHandle<Object> Isolate::CallFinalizationRegistryCallback(
+    DirectHandle<Object> callback, DirectHandle<Object> held_value) {
+  if (!finalization_registry_call_hook_) {
+    DirectHandle<Object> args[] = {held_value};
+    return Execution::Call(this, callback, factory()->undefined_value(),
+                           base::VectorOf(args));
+  }
+  v8::Local<v8::Value> result;
+  ExternalCallbackScope scope(this,
+                              FUNCTION_ADDR(finalization_registry_call_hook_));
+  if (!finalization_registry_call_hook_(
+           v8::Utils::ToLocal(native_context()),
+           v8::Utils::ToLocal(callback).As<v8::Function>(),
+           v8::Utils::ToLocal(held_value))
+           .ToLocal(&result)) {
+    ReportPendingMessages();
+    return {};
+  }
+  return v8::Utils::OpenDirectHandle(*result);
+}
+
+v8::Local<v8::Context> Isolate::GetIncumbentContextForJobCallback() {
+  // A builtin can leave its own context in the physical caller frame. Use the
+  // logical script frame for this notification, respecting a newer backup.
+  DebuggableStackFrameIterator frames(this);
+  const auto* backup = top_backup_incumbent_scope();
+  v8::Local<v8::Context> incumbent;
+  if (!frames.done() &&
+      (backup == nullptr ||
+       frames.frame()->sp() < backup->JSStackComparableAddressPrivate())) {
+    incumbent = v8::Utils::ToLocal(frames.GetTopValidFrame().native_context())
+                    .As<v8::Context>();
+  } else if (backup != nullptr) {
+    incumbent = backup->backup_incumbent_context_;
+  } else {
+    incumbent = reinterpret_cast<v8::Isolate*>(this)
+                    ->GetEnteredOrMicrotaskContext();
+  }
+  return incumbent;
+}
