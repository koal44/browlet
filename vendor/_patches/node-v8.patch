+Error.prepareStackTrace = (error, frames) => frames[0].getEvalOrigin();
+
+function first(source) { return (0, eval)(source); }
+function second(source) { return (0, eval)(source); }
+
+for (const source of ['new Error()', '() => new Error()']) {
+  const values = [first(source), second(source), first(source)];
+  const errors = values.map(value =>
+    typeof value === 'function' ? value() : value);
+  assertMatches(/eval at first /, errors[0].stack);
+  assertMatches(/eval at second /, errors[1].stack);
+  assertEquals(errors[0].stack, errors[2].stack);
+}
+
+const source = 'new Error()';
+const errors = [
+  (0, eval)(source),
+  (0, eval)(source),
+  (0, eval)(source),
+];
+assertNotEquals(errors[0].stack, errors[1].stack);
+assertNotEquals(errors[1].stack, errors[2].stack);
