+  getAll(id) {
+    // Duplicate IDs still rescan the tree. A better cache would keep duplicate
+    // elements directly, but this avoids changing the normal getElementById() path.
+    const value = this._map.get(id);
+    if (!value) {
+      return [];
+    }
+
+    if (value.count === 1 && value.element) {
+      return [value.element];
+    }
+
+    const elements = [];
+    let i = 0;
+
+    for (const descendant of domSymbolTree.treeIterator(this._root)) {
+      if (descendant.nodeType === NODE_TYPE.ELEMENT_NODE && descendant.getAttributeNS(null, "id") === id) {
+        elements[i++] = descendant;
+      }
+    }
+
+    if (i === 0) {
+      this._map.delete(id);
+    } else {
+      value.element = elements[0];
+      value.count = i;
+    }
+
+    return elements;
+  }
 };
