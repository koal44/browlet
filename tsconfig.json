{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "outDir": "./dist/.typecheck/root",
    "tsBuildInfoFile": "./dist/.typecheck/root.tsbuildinfo"
  },
  "files": [
    "vitest.config.ts",
    "playwright.config.ts",
    // Public package entries belong here for typechecking and type-aware linting.
    "packages/browlet/index.ts",
    "packages/stylelet/index.ts",
    "packages/stylelet/browser.ts",
    "packages/selectlet/index.ts",
    "packages/selectlet/browser.ts"
  ],
  "references": [
    { "path": "./src/shared" },
    { "path": "./src/url" },
    { "path": "./src/web-idl/declaration" },
    { "path": "./src/web-idl" },
    { "path": "./src/selectlet" },
    { "path": "./src/stylelet" },
    { "path": "./src/domlet" },
    { "path": "./src/browlet" },
    { "path": "./scripts" },
    { "path": "./test" }
  ]
}
