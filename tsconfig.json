{
  "compilerOptions": {
    "target": "ES2020",
    "module": "preserve",
    "strict": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "skipLibCheck": false,
    "noUncheckedIndexedAccess": true,
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "src/stylelet/**/*"
  ]
}
