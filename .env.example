BROWLET_NODE_RUNTIME=stock

# Use --runtime addon for stock Node plus node-compat/addon (build it first).

# Compatible mode requires an absolute path to a Browlet-compatible Node build.
# BROWLET_COMPAT_NODE=C:/path/to/node/out/Release/node.exe

# Optional: pin stock mode instead of using the Node executable which launches
# scripts/with-node.mjs.
# BROWLET_STOCK_NODE=C:/Program Files/nodejs/node.exe
