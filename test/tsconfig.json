    { "path": "../src/url" },
    { "path": "../src/web-idl/core" },
    { "path": "../src/web-idl" },
    { "path": "../src/streams" },
    { "path": "../src/encoding" },
    { "path": "../src/http/struct-fields" },
    { "path": "../src/file" },
    { "path": "../src/xhr" },
    { "path": "../src/fetch" },
    { "path": "../src/selectlet" },
    { "path": "../src/stylelet" },
    { "path": "../src/browlet" }
  ]
