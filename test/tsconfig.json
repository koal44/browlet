{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noUncheckedIndexedAccess": false,
    "outDir": "../dist/.typecheck/test",
    "tsBuildInfoFile": "../dist/.typecheck/test.tsbuildinfo"
  },
  "include": [
    "./**/*.ts"
  ],
  "references": [
    { "path": "../src/shared" },
    { "path": "../src/selectlet" },
    { "path": "../src/stylelet" },
    { "path": "../src" }
  ]
}
