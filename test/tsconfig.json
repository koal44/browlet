{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "outDir": "../dist/.typecheck/test",
    "tsBuildInfoFile": "../dist/.typecheck/test.tsbuildinfo"
  },
  "include": [
    "./**/*.ts"
